<div class="max-w-2xl mx-auto">
  <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-8 md:p-12">
    <div class="text-center mb-10">
      <div class="w-16 h-16 bg-blue-100 text-blue-600 rounded-2xl flex items-center justify-center mx-auto mb-6">
        <i class="fa-solid fa-cake-candles text-3xl"></i>
      </div>
      <h1 class="text-3xl font-bold text-gray-900 mb-3">Age Calculator</h1>
      <p class="text-gray-600">Type your date of birth manually or pick it from the calendar - both work.</p>
    </div>

    <form id="ageForm" class="space-y-6" novalidate>
      <div class="space-y-3">
        <label class="block text-sm font-medium text-gray-700">Date of Birth</label>

        <div class="grid grid-cols-3 gap-2">
          <div>
            <label for="dob-day" class="text-xs text-gray-500">Day</label>
            <input id="dob-day" type="number" min="1" max="31" placeholder="DD"
              class="w-full mt-1 px-3 py-2 rounded-xl border border-gray-300 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 text-center font-mono"/>
          </div>
          <div>
            <label for="dob-month" class="text-xs text-gray-500">Month</label>
            <select id="dob-month" class="w-full mt-1 px-3 py-2 rounded-xl border border-gray-300 focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
              <option value="">MM</option>
              <% const months = ["January","February","March","April","May","June","July","August","September","October","November","December"]; %>
              <% months.forEach((m, i) => { %>
                <option value="<%= i + 1 %>"><%= (i + 1).toString().padStart(2, '0') %> - <%= m %></option>
              <% }); %>
            </select>
          </div>
          <div>
            <label for="dob-year" class="text-xs text-gray-500">Year</label>
            <input id="dob-year" type="number" min="1900" max="2100" placeholder="YYYY"
              class="w-full mt-1 px-3 py-2 rounded-xl border border-gray-300 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 text-center font-mono"/>
          </div>
        </div>

        <div class="flex items-center gap-2">
          <span class="text-xs text-gray-400 uppercase tracking-wider">or pick a date</span>
          <input id="dob" type="date" class="ml-auto px-3 py-2 rounded-xl border border-gray-300 focus:ring-2 focus:ring-blue-500 focus:border-blue-500"/>
        </div>

        <p id="dob-error" class="hidden text-sm text-red-600"></p>
      </div>

      <button type="submit"
        class="w-full bg-blue-600 text-white font-semibold py-3 px-6 rounded-xl hover:bg-blue-700 transition-colors shadow-lg hover:shadow-xl transform hover:-translate-y-0.5">
        <i class="fa-solid fa-calculator mr-2"></i> Calculate Age
      </button>
    </form>

    <div id="result" class="hidden mt-10 space-y-6">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        <div class="bg-blue-50 p-4 rounded-xl text-center">
          <span id="years" class="block text-3xl font-bold text-blue-600">0</span>
          <span class="text-sm text-blue-600 font-medium">Years</span>
        </div>
        <div class="bg-blue-50 p-4 rounded-xl text-center">
          <span id="months" class="block text-3xl font-bold text-blue-600">0</span>
          <span class="text-sm text-blue-600 font-medium">Months</span>
        </div>
        <div class="bg-blue-50 p-4 rounded-xl text-center">
          <span id="weeks" class="block text-3xl font-bold text-blue-600">0</span>
          <span class="text-sm text-blue-600 font-medium">Weeks</span>
        </div>
        <div class="bg-blue-50 p-4 rounded-xl text-center">
          <span id="days" class="block text-3xl font-bold text-blue-600">0</span>
          <span class="text-sm text-blue-600 font-medium">Days</span>
        </div>
      </div>

      <div class="grid sm:grid-cols-3 gap-3 text-sm">
        <div class="bg-gray-50 p-3 rounded-xl text-center">
          <div class="text-xs text-gray-500 uppercase tracking-wide">Total months</div>
          <div id="totalMonths" class="text-lg font-bold text-gray-800">0</div>
        </div>
        <div class="bg-gray-50 p-3 rounded-xl text-center">
          <div class="text-xs text-gray-500 uppercase tracking-wide">Total weeks</div>
          <div id="totalWeeks" class="text-lg font-bold text-gray-800">0</div>
        </div>
        <div class="bg-gray-50 p-3 rounded-xl text-center">
          <div class="text-xs text-gray-500 uppercase tracking-wide">Total days</div>
          <div id="totalDays" class="text-lg font-bold text-gray-800">0</div>
        </div>
      </div>

      <div class="bg-gradient-to-r from-blue-50 to-indigo-50 p-6 rounded-xl text-center">
        <p class="text-gray-600">Your next birthday is in</p>
        <p id="nextBirthday" class="text-xl font-semibold text-gray-900 mt-1"></p>
      </div>
    </div>
  </div>
</div>

<script>
  (function () {
    const dayEl = document.getElementById("dob-day");
    const monthEl = document.getElementById("dob-month");
    const yearEl = document.getElementById("dob-year");
    const dateEl = document.getElementById("dob");
    const error = document.getElementById("dob-error");
    let syncing = false;

    // Picker -> manual fields
    dateEl.addEventListener("change", () => {
      if (syncing || !dateEl.value) return;
      syncing = true;
      const [y, m, d] = dateEl.value.split("-");
      yearEl.value = +y;
      monthEl.value = +m;
      dayEl.value = +d;
      syncing = false;
    });

    // Manual fields -> picker
    [dayEl, monthEl, yearEl].forEach((el) => el.addEventListener("input", () => {
      if (syncing) return;
      const d = +dayEl.value, m = +monthEl.value, y = +yearEl.value;
      if (d >= 1 && d <= 31 && m >= 1 && m <= 12 && y >= 1900 && y <= 2100) {
        syncing = true;
        dateEl.value = `${y}-${String(m).padStart(2, "0")}-${String(d).padStart(2, "0")}`;
        syncing = false;
      }
    }));

    function readDob() {
      const d = +dayEl.value;
      const m = +monthEl.value;
      const y = +yearEl.value;
      if (!d || !m || !y) return null;
      const dt = new Date(y, m - 1, d);
      // Validate roundtrip (catches Feb 30 etc.)
      if (dt.getFullYear() !== y || dt.getMonth() !== m - 1 || dt.getDate() !== d) return null;
      return dt;
    }

    document.getElementById("ageForm").addEventListener("submit", (e) => {
      e.preventDefault();
      error.classList.add("hidden");
      error.textContent = "";

      const dob = readDob();
      if (!dob) {
        error.textContent = "Please enter a valid date - check the day/month/year values.";
        error.classList.remove("hidden");
        return;
      }
      const now = new Date();
      if (dob > now) {
        error.textContent = "Date of birth can't be in the future.";
        error.classList.remove("hidden");
        return;
      }

      let years = now.getFullYear() - dob.getFullYear();
      let months = now.getMonth() - dob.getMonth();
      let days = now.getDate() - dob.getDate();
      if (days < 0) {
        months--;
        days += new Date(now.getFullYear(), now.getMonth(), 0).getDate();
      }
      if (months < 0) {
        years--;
        months += 12;
      }
      const weeks = Math.floor(days / 7);
      const remDays = days % 7;

      document.getElementById("years").textContent = years;
      document.getElementById("months").textContent = months;
      document.getElementById("weeks").textContent = weeks;
      document.getElementById("days").textContent = remDays;

      const totalDays = Math.floor((now - dob) / (1000 * 60 * 60 * 24));
      document.getElementById("totalDays").textContent = totalDays.toLocaleString();
      document.getElementById("totalWeeks").textContent = Math.floor(totalDays / 7).toLocaleString();
      document.getElementById("totalMonths").textContent = (years * 12 + months).toLocaleString();

      let nextBirthday = new Date(dob);
      nextBirthday.setFullYear(now.getFullYear());
      if (nextBirthday < now) nextBirthday.setFullYear(now.getFullYear() + 1);
      const diffDays = Math.ceil((nextBirthday - now) / (1000 * 60 * 60 * 24));
      document.getElementById("nextBirthday").textContent = `${diffDays} day${diffDays === 1 ? "" : "s"}`;

      document.getElementById("result").classList.remove("hidden");
    });
  })();
</script>
