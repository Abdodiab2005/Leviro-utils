<div class="min-h-[60vh] flex flex-col items-center justify-center text-center px-4">
  <div class="w-24 h-24 bg-indigo-100 text-indigo-600 rounded-full flex items-center justify-center mb-8">
    <i class="fa-solid fa-map-location-dot text-5xl"></i>
  </div>
  <p class="text-8xl font-extrabold text-indigo-600 mb-4">404</p>
  <h1 class="text-2xl font-bold text-gray-900 mb-3">
    <%= locale === 'ar' ? 'الصفحة غير موجودة' : 'Page Not Found' %>
  </h1>
  <p class="text-gray-600 max-w-md mx-auto mb-8">
    <%= locale === 'ar'
      ? 'الصفحة التي تبحث عنها غير موجودة أو ربما تم نقلها.'
      : "The page you're looking for doesn't exist or has been moved." %>
  </p>
  <div class="flex gap-4 flex-wrap justify-center">
    <a href="<%= localePrefix || '/' %>"
       class="px-8 py-3 bg-indigo-600 text-white font-semibold rounded-full hover:bg-indigo-700 transition-colors shadow-lg">
      <%= locale === 'ar' ? 'العودة للرئيسية' : 'Back to Home' %>
    </a>
    <a href="<%= localePrefix %>/categories"
       class="px-8 py-3 bg-white text-indigo-600 font-semibold rounded-full hover:bg-indigo-50 transition-colors shadow border border-indigo-200">
      <%= locale === 'ar' ? 'تصفح الأدوات' : 'Browse Tools' %>
    </a>
  </div>
</div>
