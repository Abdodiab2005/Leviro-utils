<div class="max-w-4xl mx-auto">
  <%- include('../partials/tool-header', {
    heading: 'CSS Minifier & Beautifier',
    subtitle: 'Compress CSS to reduce file size, or beautify minified CSS to make it readable. Runs entirely in your browser - no upload, no signup.',
    icon: 'fa-brands fa-css3-alt',
    color: 'bg-blue-100 text-blue-600'
  }) %>

  <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 md:p-8 space-y-6">
    <div class="flex gap-2 bg-gray-100 p-1 rounded-xl w-fit mx-auto">
      <button data-mode="minify" class="mode-btn px-4 py-2 rounded-lg bg-white shadow font-medium">Minify</button>
      <button data-mode="beautify" class="mode-btn px-4 py-2 rounded-lg font-medium text-gray-600">Beautify</button>
    </div>

    <div>
      <label class="text-sm font-medium text-gray-700 mb-2 block">Input CSS</label>
      <textarea id="css-in" rows="10" placeholder="body { background: #fff; color: #333; }"
        class="w-full p-4 border border-gray-200 rounded-xl font-mono text-xs"></textarea>
    </div>

    <div>
      <div class="flex justify-between items-center mb-2">
        <label class="text-sm font-medium text-gray-700">Output</label>
        <div class="flex gap-3 items-center">
          <span id="css-stats" class="text-xs text-gray-500"></span>
          <button id="css-copy" class="text-sm text-blue-600"><i class="fa-regular fa-copy mr-1"></i>Copy</button>
        </div>
      </div>
      <textarea id="css-out" rows="10" readonly class="w-full p-4 border border-gray-200 rounded-xl bg-gray-50 font-mono text-xs"></textarea>
    </div>
  </div>
</div>

<script>
  const input = document.getElementById("css-in");
  const output = document.getElementById("css-out");
  const stats = document.getElementById("css-stats");
  const buttons = document.querySelectorAll(".mode-btn");
  let mode = "minify";

  function minify(css) {
    return css
      .replace(/\/\*[\s\S]*?\*\//g, "")
      .replace(/\s+/g, " ")
      .replace(/\s*([:;{},])\s*/g, "$1")
      .replace(/;}/g, "}")
      .trim();
  }

  function beautify(css) {
    let result = "";
    let indent = 0;
    const t = (n) => "  ".repeat(n);
    const compact = css.replace(/\s+/g, " ").trim();
    let i = 0;
    while (i < compact.length) {
      const c = compact[i];
      if (c === "{") {
        result = result.replace(/\s+$/, "") + " {\n";
        indent++;
        result += t(indent);
      } else if (c === "}") {
        indent = Math.max(0, indent - 1);
        result = result.replace(/\s+$/, "") + "\n" + t(indent) + "}\n" + (indent === 0 ? "\n" : t(indent));
      } else if (c === ";") {
        result += ";\n" + t(indent);
      } else {
        result += c;
      }
      i++;
    }
    return result.trim();
  }

  function run() {
    const v = input.value;
    if (!v) { output.value = ""; stats.textContent = ""; return; }
    output.value = mode === "minify" ? minify(v) : beautify(v);
    const orig = new Blob([v]).size;
    const out = new Blob([output.value]).size;
    if (mode === "minify") {
      const saved = orig - out;
      const pct = orig ? Math.round((saved / orig) * 100) : 0;
      stats.textContent = `${orig} B → ${out} B (saved ${pct}%)`;
    } else {
      stats.textContent = `${orig} B → ${out} B`;
    }
  }

  buttons.forEach((b) => b.addEventListener("click", () => {
    mode = b.dataset.mode;
    buttons.forEach((x) => {
      x.classList.toggle("bg-white", x === b);
      x.classList.toggle("shadow", x === b);
      x.classList.toggle("text-gray-600", x !== b);
    });
    run();
  }));

  input.addEventListener("input", run);
  document.getElementById("css-copy").addEventListener("click", async () => {
    if (output.value) await navigator.clipboard.writeText(output.value);
  });
</script>
