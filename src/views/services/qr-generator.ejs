<div class="max-w-4xl mx-auto">
  <div
    class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 md:p-10"
  >
    <div class="text-center mb-8">
      <div
        class="inline-flex items-center justify-center w-16 h-16 rounded-2xl bg-blue-100 text-blue-600 mb-4"
      >
        <i class="fa-solid fa-qrcode text-2xl"></i>
      </div>
      <h1 class="text-3xl font-bold text-gray-900 mb-2">QR Code Generator</h1>
      <p class="text-gray-600 max-w-xl mx-auto">
        Generate customizable QR codes for any URL or text. Pick your colors,
        error correction, and download as PNG. Renders entirely in your browser.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      <div class="space-y-5">
        <div>
          <label
            class="block text-sm font-medium text-gray-700 mb-2"
            for="qrText"
            >Content</label
          >
          <textarea
            id="qrText"
            rows="3"
            class="w-full p-3 rounded-xl border border-gray-300 bg-white text-gray-900 focus:ring-2 focus:ring-blue-500 focus:border-transparent text-sm"
            placeholder="https://example.com or any text..."
          ></textarea>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-2"
              >Foreground</label
            >
            <input
              type="color"
              id="darkColor"
              value="#000000"
              class="h-10 w-full rounded cursor-pointer"
            />
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-2"
              >Background</label
            >
            <input
              type="color"
              id="lightColor"
              value="#ffffff"
              class="h-10 w-full rounded cursor-pointer"
            />
          </div>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-2"
              >Size (px)</label
            >
            <input
              type="number"
              id="qrSize"
              min="100"
              max="1024"
              value="400"
              class="w-full p-3 rounded-xl border border-gray-300 text-sm"
            />
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-2"
              >Error correction</label
            >
            <select
              id="qrEcc"
              class="w-full p-3 rounded-xl border border-gray-300 text-sm"
            >
              <option value="L">L - 7%</option>
              <option value="M">M - 15%</option>
              <option value="Q">Q - 25%</option>
              <option value="H" selected>H - 30%</option>
            </select>
          </div>
        </div>
      </div>

      <div
        class="flex flex-col items-center justify-center p-6 bg-gray-50 rounded-xl border-2 border-dashed border-gray-300 min-h-[280px]"
      >
        <div id="qrPlaceholder" class="text-gray-400 text-center">
          <i class="fa-solid fa-qrcode text-5xl opacity-40 mb-2"></i>
          <p class="text-sm">QR code will appear here</p>
        </div>
        <canvas
          id="qrCanvas"
          class="hidden max-w-full rounded-lg shadow"
        ></canvas>

        <a
          id="downloadBtn"
          download="qrcode.png"
          class="hidden mt-4 inline-flex items-center px-4 py-2 bg-green-600 hover:bg-green-700 text-white font-medium rounded-lg transition-colors text-sm"
        >
          <i class="fa-solid fa-download mr-2"></i> Download PNG
        </a>
      </div>
    </div>
  </div>
</div>

<script
  src="https://cdn.jsdelivr.net/npm/qrcode@1.5.4/build/qrcode.min.js"
  crossorigin="anonymous"
  referrerpolicy="no-referrer"
  defer
></script>
<script>
  (function () {
    const text = document.getElementById("qrText");
    const dark = document.getElementById("darkColor");
    const light = document.getElementById("lightColor");
    const size = document.getElementById("qrSize");
    const ecc = document.getElementById("qrEcc");
    const canvas = document.getElementById("qrCanvas");
    const placeholder = document.getElementById("qrPlaceholder");
    const dl = document.getElementById("downloadBtn");

    let pending = false;

    function render() {
      if (typeof QRCode === "undefined") {
        if (!pending) {
          pending = true;
          setTimeout(render, 200);
        }
        return;
      }
      pending = false;
      const value = text.value.trim();
      if (!value) {
        canvas.classList.add("hidden");
        dl.classList.add("hidden");
        placeholder.classList.remove("hidden");
        return;
      }
      const px = Math.max(100, Math.min(1024, parseInt(size.value, 10) || 400));
      QRCode.toCanvas(
        canvas,
        value,
        {
          width: px,
          margin: 2,
          errorCorrectionLevel: ecc.value,
          color: { dark: dark.value, light: light.value },
        },
        (err) => {
          if (err) {
            console.error(err);
            return;
          }
          canvas.classList.remove("hidden");
          placeholder.classList.add("hidden");
          dl.classList.remove("hidden");
          dl.href = canvas.toDataURL("image/png");
        },
      );
    }

    [text, dark, light, size, ecc].forEach((el) =>
      el.addEventListener("input", render),
    );
    text.value = "https://utils.leviro.net";
    window.addEventListener("load", render);
  })();
</script>
