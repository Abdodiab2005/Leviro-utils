<div class="max-w-2xl mx-auto">
  <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-8 md:p-12">
    <div class="text-center mb-10">
      <div
        class="w-16 h-16 bg-purple-100 text-purple-600 rounded-2xl flex items-center justify-center mx-auto mb-6"
      >
        <i class="fa-solid fa-user-secret text-3xl"></i>
      </div>
      <h1 class="text-3xl font-bold text-gray-900 mb-3">Secret Key Generator</h1>
      <p class="text-gray-600 max-w-lg mx-auto">
        Cryptographically secure random secrets for JWT signing, API keys,
        session secrets, and environment variables. Generated locally - your
        secret never leaves the browser.
      </p>
    </div>

    <div class="space-y-6">
      <div class="bg-gray-50 p-6 rounded-xl">
        <div class="flex justify-between mb-2">
          <label class="font-medium text-gray-700">Secret length</label>
          <span id="lengthValue" class="font-mono text-purple-600 font-bold">32</span>
        </div>
        <input
          type="range"
          id="length"
          min="8"
          max="255"
          value="32"
          class="w-full h-2 bg-gray-200 rounded-lg appearance-none cursor-pointer accent-purple-600"
        />
        <div class="flex justify-between text-xs text-gray-500 mt-1">
          <span>8</span>
          <span>255</span>
        </div>
      </div>

      <div>
        <label class="text-sm font-medium text-gray-700 mb-2 block">Encoding</label>
        <div class="grid grid-cols-3 gap-2">
          <button data-fmt="hex" class="fmt-btn px-3 py-2 rounded-lg bg-purple-600 text-white font-medium">Hex</button>
          <button data-fmt="base64" class="fmt-btn px-3 py-2 rounded-lg bg-gray-100 text-gray-700 font-medium">Base64</button>
          <button data-fmt="base64url" class="fmt-btn px-3 py-2 rounded-lg bg-gray-100 text-gray-700 font-medium">Base64 URL</button>
        </div>
      </div>

      <div class="relative">
        <div
          class="bg-gray-50 p-4 pr-12 rounded-xl border border-gray-200 break-all font-mono text-base text-gray-800 min-h-14 flex items-center"
          id="result"
          aria-live="polite"
        >
          Click generate
        </div>
        <button
          id="copyBtn"
          class="absolute top-2 right-2 p-2 text-gray-400 hover:text-purple-600 transition-colors"
          aria-label="Copy to clipboard"
        >
          <i class="fa-regular fa-copy text-xl"></i>
        </button>
      </div>

      <button
        id="generateBtn"
        class="w-full bg-purple-600 text-white font-semibold py-3 px-6 rounded-xl hover:bg-purple-700 transition-colors shadow-lg hover:shadow-xl transform hover:-translate-y-0.5"
      >
        <i class="fa-solid fa-bolt mr-2"></i> Generate Secret
      </button>

      <p class="text-xs text-center text-gray-400">
        <i class="fa-solid fa-shield-halved"></i>
        Generated with the Web Crypto API. Nothing is sent to a server.
      </p>
    </div>
  </div>
</div>

<script>
  (function () {
    const result = document.getElementById("result");
    const generateBtn = document.getElementById("generateBtn");
    const copyBtn = document.getElementById("copyBtn");
    const lengthSlider = document.getElementById("length");
    const lengthValue = document.getElementById("lengthValue");
    const fmtButtons = document.querySelectorAll(".fmt-btn");
    let format = "hex";

    lengthSlider.addEventListener("input", (e) => {
      lengthValue.textContent = e.target.value;
      generate();
    });

    fmtButtons.forEach((b) => b.addEventListener("click", () => {
      format = b.dataset.fmt;
      fmtButtons.forEach((x) => {
        const active = x === b;
        x.classList.toggle("bg-purple-600", active);
        x.classList.toggle("text-white", active);
        x.classList.toggle("bg-gray-100", !active);
        x.classList.toggle("text-gray-700", !active);
      });
      generate();
    }));

    function bytesToHex(bytes) {
      return Array.from(bytes).map((b) => b.toString(16).padStart(2, "0")).join("");
    }
    function bytesToBase64(bytes) {
      let s = "";
      for (let i = 0; i < bytes.length; i++) s += String.fromCharCode(bytes[i]);
      return btoa(s);
    }

    function generate() {
      const length = parseInt(lengthSlider.value, 10);
      const byteLen = format === "hex" ? Math.ceil(length / 2) : Math.ceil((length * 3) / 4);
      const bytes = new Uint8Array(byteLen);
      crypto.getRandomValues(bytes);
      let out;
      if (format === "hex") {
        out = bytesToHex(bytes).slice(0, length);
      } else if (format === "base64") {
        out = bytesToBase64(bytes).slice(0, length);
      } else {
        out = bytesToBase64(bytes).replace(/\+/g, "-").replace(/\//g, "_").replace(/=+$/, "").slice(0, length);
      }
      result.textContent = out;
    }

    generateBtn.addEventListener("click", generate);
    copyBtn.addEventListener("click", async () => {
      const text = result.textContent;
      if (!text || text === "Click generate") return;
      await navigator.clipboard.writeText(text);
      const original = copyBtn.innerHTML;
      copyBtn.innerHTML = '<i class="fa-solid fa-check text-green-500 text-xl"></i>';
      setTimeout(() => { copyBtn.innerHTML = original; }, 1500);
    });

    generate();
  })();
</script>
