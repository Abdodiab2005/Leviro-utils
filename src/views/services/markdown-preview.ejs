<div class="max-w-6xl mx-auto">
  <%- include('../partials/tool-header', {
    heading: 'Markdown Previewer',
    subtitle: 'Write Markdown on the left, see the rendered HTML on the right in real time. Supports headings, lists, code, links, and tables.',
    icon: 'fa-brands fa-markdown',
    color: 'bg-slate-100 text-slate-700'
  }) %>

  <div class="grid lg:grid-cols-2 gap-4">
    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-4">
      <div class="flex justify-between items-center mb-2">
        <label class="text-sm font-semibold text-gray-700">Markdown</label>
        <button id="md-copy" class="text-sm text-slate-700"><i class="fa-regular fa-copy mr-1"></i>Copy HTML</button>
      </div>
      <textarea id="md-in" rows="20" class="w-full p-4 border border-gray-200 rounded-xl font-mono text-sm" placeholder="# Hello World"></textarea>
    </div>
    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-4">
      <label class="block text-sm font-semibold text-gray-700 mb-2">Preview</label>
      <article id="md-out" class="md-rendered max-w-none p-4 border border-gray-100 rounded-xl bg-gray-50 min-h-[480px]"></article>
    </div>
  </div>
</div>

<script>
  function escapeHtml(s) {
    return s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
  }

  function md(src) {
    const lines = src.split("\n");
    let html = "";
    let inCode = false, inList = false, listType = "";
    for (let i = 0; i < lines.length; i++) {
      let line = lines[i];

      // Fenced code blocks
      const fence = line.match(/^```(\w*)$/);
      if (fence) {
        if (inCode) { html += "</code></pre>"; inCode = false; }
        else { html += `<pre class="bg-gray-900 text-gray-100 p-3 rounded-lg overflow-x-auto"><code>`; inCode = true; }
        continue;
      }
      if (inCode) { html += escapeHtml(line) + "\n"; continue; }

      // Headings
      const h = line.match(/^(#{1,6})\s+(.*)$/);
      if (h) { if (inList) { html += `</${listType}>`; inList = false; } html += `<h${h[1].length}>${inline(h[2])}</h${h[1].length}>`; continue; }

      // Lists
      const ul = line.match(/^[-*]\s+(.*)$/);
      const ol = line.match(/^\d+\.\s+(.*)$/);
      if (ul || ol) {
        const t = ul ? "ul" : "ol";
        if (!inList || listType !== t) { if (inList) html += `</${listType}>`; html += `<${t}>`; inList = true; listType = t; }
        html += `<li>${inline((ul||ol)[1])}</li>`;
        continue;
      }
      if (inList) { html += `</${listType}>`; inList = false; }

      // Horizontal rule
      if (/^\s*---\s*$/.test(line)) { html += "<hr/>"; continue; }

      // Blank line
      if (line.trim() === "") continue;

      // Paragraph
      html += `<p>${inline(line)}</p>`;
    }
    if (inList) html += `</${listType}>`;
    if (inCode) html += "</code></pre>";
    return html;
  }

  function inline(s) {
    return escapeHtml(s)
      .replace(/`([^`]+)`/g, '<code class="bg-gray-200 px-1 rounded">$1</code>')
      .replace(/\*\*([^*]+)\*\*/g, "<strong>$1</strong>")
      .replace(/\*([^*]+)\*/g, "<em>$1</em>")
      .replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a class="text-indigo-600 underline" href="$2" rel="noopener">$1</a>');
  }

  const input = document.getElementById("md-in");
  const out = document.getElementById("md-out");
  input.value = "# Welcome to Leviro Utils\n\nType **Markdown** here and see the *preview* update live.\n\n- Lists work\n- Like this\n\n```\nconst hello = 'world';\n```";
  function render() { out.innerHTML = md(input.value); }
  input.addEventListener("input", render);
  document.getElementById("md-copy").addEventListener("click", async () => {
    await navigator.clipboard.writeText(out.innerHTML);
  });
  render();
</script>
