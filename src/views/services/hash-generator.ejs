<div class="max-w-3xl mx-auto">
  <%- include('../partials/tool-header', {
    heading: 'Hash Generator',
    subtitle: 'Generate SHA-1, SHA-256, SHA-384, SHA-512 and MD5 hashes from any input. Computed locally with the Web Crypto API.',
    icon: 'fa-solid fa-fingerprint',
    color: 'bg-rose-100 text-rose-600'
  }) %>

  <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 md:p-8 space-y-6">
    <div>
      <label class="block text-sm font-medium text-gray-700 mb-2">Input text</label>
      <textarea id="hash-input" rows="5" placeholder="Type or paste anything..."
        class="w-full p-4 border border-gray-200 rounded-xl focus:ring-2 focus:ring-rose-500 font-mono text-sm"></textarea>
    </div>

    <div class="space-y-3" id="hash-results"></div>
  </div>
</div>

<script>
  const algorithms = ["MD5", "SHA-1", "SHA-256", "SHA-384", "SHA-512"];
  const results = document.getElementById("hash-results");
  const input = document.getElementById("hash-input");

  results.innerHTML = algorithms.map((a) => `
    <div>
      <div class="flex justify-between items-center mb-1">
        <label class="text-sm font-semibold text-gray-700">${a}</label>
        <button data-copy="${a}" class="text-xs text-rose-600 hover:text-rose-700"><i class="fa-regular fa-copy mr-1"></i>Copy</button>
      </div>
      <input data-out="${a}" readonly class="w-full p-3 bg-gray-50 border border-gray-200 rounded-lg font-mono text-xs"/>
    </div>`).join("");

  function md5(s) {
    function rh(n){let j,s='';for(j=0;j<=3;j++)s+=((n>>(j*8+4))&0x0F).toString(16)+((n>>(j*8))&0x0F).toString(16);return s}
    function ad(x,y){const l=(x&0xFFFF)+(y&0xFFFF);const m=(x>>16)+(y>>16)+(l>>16);return(m<<16)|(l&0xFFFF)}
    function rl(n,c){return(n<<c)|(n>>>(32-c))}
    function cmn(q,a,b,x,s,t){return ad(rl(ad(ad(a,q),ad(x,t)),s),b)}
    function ff(a,b,c,d,x,s,t){return cmn((b&c)|((~b)&d),a,b,x,s,t)}
    function gg(a,b,c,d,x,s,t){return cmn((b&d)|(c&(~d)),a,b,x,s,t)}
    function hh(a,b,c,d,x,s,t){return cmn(b^c^d,a,b,x,s,t)}
    function ii(a,b,c,d,x,s,t){return cmn(c^(b|(~d)),a,b,x,s,t)}
    function s2b(s){const n=((s.length+8)>>6)+1,b=new Array(n*16).fill(0);for(let i=0;i<s.length;i++)b[i>>2]|=s.charCodeAt(i)<<((i%4)*8);b[s.length>>2]|=0x80<<((s.length%4)*8);b[n*16-2]=s.length*8;return b}
    const x=s2b(unescape(encodeURIComponent(s)));let a=1732584193,b=-271733879,c=-1732584194,d=271733878;
    for(let i=0;i<x.length;i+=16){const oa=a,ob=b,oc=c,od=d;
      a=ff(a,b,c,d,x[i+0],7,-680876936);d=ff(d,a,b,c,x[i+1],12,-389564586);c=ff(c,d,a,b,x[i+2],17,606105819);b=ff(b,c,d,a,x[i+3],22,-1044525330);
      a=ff(a,b,c,d,x[i+4],7,-176418897);d=ff(d,a,b,c,x[i+5],12,1200080426);c=ff(c,d,a,b,x[i+6],17,-1473231341);b=ff(b,c,d,a,x[i+7],22,-45705983);
      a=ff(a,b,c,d,x[i+8],7,1770035416);d=ff(d,a,b,c,x[i+9],12,-1958414417);c=ff(c,d,a,b,x[i+10],17,-42063);b=ff(b,c,d,a,x[i+11],22,-1990404162);
      a=ff(a,b,c,d,x[i+12],7,1804603682);d=ff(d,a,b,c,x[i+13],12,-40341101);c=ff(c,d,a,b,x[i+14],17,-1502002290);b=ff(b,c,d,a,x[i+15],22,1236535329);
      a=gg(a,b,c,d,x[i+1],5,-165796510);d=gg(d,a,b,c,x[i+6],9,-1069501632);c=gg(c,d,a,b,x[i+11],14,643717713);b=gg(b,c,d,a,x[i+0],20,-373897302);
      a=gg(a,b,c,d,x[i+5],5,-701558691);d=gg(d,a,b,c,x[i+10],9,38016083);c=gg(c,d,a,b,x[i+15],14,-660478335);b=gg(b,c,d,a,x[i+4],20,-405537848);
      a=gg(a,b,c,d,x[i+9],5,568446438);d=gg(d,a,b,c,x[i+14],9,-1019803690);c=gg(c,d,a,b,x[i+3],14,-187363961);b=gg(b,c,d,a,x[i+8],20,1163531501);
      a=gg(a,b,c,d,x[i+13],5,-1444681467);d=gg(d,a,b,c,x[i+2],9,-51403784);c=gg(c,d,a,b,x[i+7],14,1735328473);b=gg(b,c,d,a,x[i+12],20,-1926607734);
      a=hh(a,b,c,d,x[i+5],4,-378558);d=hh(d,a,b,c,x[i+8],11,-2022574463);c=hh(c,d,a,b,x[i+11],16,1839030562);b=hh(b,c,d,a,x[i+14],23,-35309556);
      a=hh(a,b,c,d,x[i+1],4,-1530992060);d=hh(d,a,b,c,x[i+4],11,1272893353);c=hh(c,d,a,b,x[i+7],16,-155497632);b=hh(b,c,d,a,x[i+10],23,-1094730640);
      a=hh(a,b,c,d,x[i+13],4,681279174);d=hh(d,a,b,c,x[i+0],11,-358537222);c=hh(c,d,a,b,x[i+3],16,-722521979);b=hh(b,c,d,a,x[i+6],23,76029189);
      a=hh(a,b,c,d,x[i+9],4,-640364487);d=hh(d,a,b,c,x[i+12],11,-421815835);c=hh(c,d,a,b,x[i+15],16,530742520);b=hh(b,c,d,a,x[i+2],23,-995338651);
      a=ii(a,b,c,d,x[i+0],6,-198630844);d=ii(d,a,b,c,x[i+7],10,1126891415);c=ii(c,d,a,b,x[i+14],15,-1416354905);b=ii(b,c,d,a,x[i+5],21,-57434055);
      a=ii(a,b,c,d,x[i+12],6,1700485571);d=ii(d,a,b,c,x[i+3],10,-1894986606);c=ii(c,d,a,b,x[i+10],15,-1051523);b=ii(b,c,d,a,x[i+1],21,-2054922799);
      a=ii(a,b,c,d,x[i+8],6,1873313359);d=ii(d,a,b,c,x[i+15],10,-30611744);c=ii(c,d,a,b,x[i+6],15,-1560198380);b=ii(b,c,d,a,x[i+13],21,1309151649);
      a=ii(a,b,c,d,x[i+4],6,-145523070);d=ii(d,a,b,c,x[i+11],10,-1120210379);c=ii(c,d,a,b,x[i+2],15,718787259);b=ii(b,c,d,a,x[i+9],21,-343485551);
      a=ad(a,oa);b=ad(b,ob);c=ad(c,oc);d=ad(d,od);
    }
    return rh(a)+rh(b)+rh(c)+rh(d);
  }

  async function digest(algo, text) {
    if (algo === "MD5") return md5(text);
    const buf = new TextEncoder().encode(text);
    const hash = await crypto.subtle.digest(algo, buf);
    return Array.from(new Uint8Array(hash)).map((b) => b.toString(16).padStart(2, "0")).join("");
  }

  async function update() {
    const v = input.value;
    for (const a of algorithms) {
      const out = document.querySelector(`[data-out="${a}"]`);
      out.value = v ? await digest(a, v) : "";
    }
  }

  input.addEventListener("input", update);
  results.addEventListener("click", async (e) => {
    const btn = e.target.closest("[data-copy]");
    if (!btn) return;
    const out = document.querySelector(`[data-out="${btn.dataset.copy}"]`);
    if (out.value) await navigator.clipboard.writeText(out.value);
  });
</script>
