<div id="dt-banner"
  class="hidden bg-amber-50 border-b border-amber-300 text-amber-900"
  role="status"
  aria-live="polite">
  <div class="container mx-auto px-4 py-3 flex items-start gap-3 text-sm">
    <i class="fa-solid fa-triangle-exclamation text-amber-600 text-lg mt-0.5"></i>
    <div class="flex-1">
      <p class="font-semibold">Heads up: DevTools is open</p>
      <p class="text-amber-800 leading-relaxed">
        With "Disable cache" on in the Network tab, every page will skip the
        service worker cache - costing you offline support. The app may also
        auto-reload more aggressively when an update arrives. Close DevTools
        for the smoothest experience.
      </p>
    </div>
    <button id="dt-dismiss" class="text-amber-700 hover:text-amber-900 p-1 shrink-0" aria-label="Dismiss">
      <i class="fa-solid fa-xmark"></i>
    </button>
  </div>
</div>

<script>
  (function () {
    const banner = document.getElementById("dt-banner");
    const dismiss = document.getElementById("dt-dismiss");
    if (!banner) return;

    const STORAGE_KEY = "leviro-dt-banner-dismissed";
    if (sessionStorage.getItem(STORAGE_KEY) === "1") return;

    // Skip detection on non-desktop devices: mobile browsers and installed PWAs
    // report outer/inner dimensions inconsistently, which would falsely flag
    // DevTools as open. DevTools is a desktop-only concern in practice.
    const mql = (q) => window.matchMedia && window.matchMedia(q).matches;
    const isTouchOnly = mql("(hover: none)") || mql("(pointer: coarse)");
    const isStandalone = mql("(display-mode: standalone)") || window.navigator.standalone === true;
    if (isTouchOnly || isStandalone) return;

    let shown = false;
    function show() {
      if (shown) return;
      shown = true;
      banner.classList.remove("hidden");
    }

    dismiss.addEventListener("click", () => {
      banner.classList.add("hidden");
      sessionStorage.setItem(STORAGE_KEY, "1");
    });

    // Heuristic 1: outer/inner size delta - reliable only when DevTools
    // is docked inside the window. We require a sizeable delta to avoid
    // tripping on browser scrollbars or zoom levels.
    function checkSize() {
      const threshold = 200;
      const widthDiff = Math.abs(window.outerWidth - window.innerWidth);
      const heightDiff = Math.abs(window.outerHeight - window.innerHeight);
      if (widthDiff > threshold || heightDiff > threshold) show();
    }

    // Heuristic 2: a getter that fires when DevTools renders a logged object
    const trap = {};
    Object.defineProperty(trap, "id", {
      get() { show(); return "leviro-utils"; },
    });

    function probe() {
      checkSize();
      console.log("%c", "color: transparent", trap);
      console.clear?.();
    }

    probe();
    setInterval(probe, 2000);
    window.addEventListener("resize", checkSize);
  })();
</script>
