<!DOCTYPE html>
<html lang="<%= locale %>" dir="<%= dir %>">
  <head>
    <%- include('../partials/head') %>
  </head>
  <body
    class="bg-gray-50 text-gray-900 font-sans antialiased flex flex-col min-h-screen"
  >
    <%- include('../partials/header') %>
    <%- include('../partials/devtools-banner') %>

    <main class="grow container mx-auto px-4 py-8"><%- body %></main>

    <%- include('../partials/footer') %>

    <div id="leviro-update-toast"
      class="fixed top-4 left-1/2 -translate-x-1/2 z-[70] hidden bg-indigo-600 text-white px-5 py-3 rounded-xl shadow-lg text-sm font-medium">
      <i class="fa-solid fa-arrows-rotate mr-2"></i>
      A new version is available - refreshing...
    </div>

    <script>
      (function () {
        if (!("serviceWorker" in navigator)) return;
        const toast = document.getElementById("leviro-update-toast");

        window.addEventListener("load", () => {
          navigator.serviceWorker
            .register("/sw.js", { updateViaCache: "none" })
            .then((registration) => {
              document.addEventListener("visibilitychange", () => {
                if (document.visibilityState === "visible") registration.update();
              });

              let refreshed = false;
              navigator.serviceWorker.addEventListener("controllerchange", () => {
                if (refreshed) return;
                refreshed = true;
                if (toast) toast.classList.remove("hidden");
                setTimeout(() => window.location.reload(), 900);
              });

              registration.addEventListener("updatefound", () => {
                const sw = registration.installing;
                if (!sw) return;
                sw.addEventListener("statechange", () => {
                  if (sw.state === "installed" && navigator.serviceWorker.controller) {
                    sw.postMessage("SKIP_WAITING");
                  }
                });
              });
            })
            .catch((err) => console.warn("SW registration failed:", err));
        });
      })();
    </script>
  </body>
</html>
