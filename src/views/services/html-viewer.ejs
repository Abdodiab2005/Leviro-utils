<div class="max-w-7xl mx-auto">
  <%- include('../partials/tool-header', {
    heading: 'HTML Viewer & Preview',
    subtitle: 'Paste HTML on the left, see it rendered live on the right inside a sandboxed iframe. Great for previewing emails, snippets, and components.',
    icon: 'fa-brands fa-html5',
    color: 'bg-orange-100 text-orange-600'
  }) %>

  <div class="grid lg:grid-cols-2 gap-4">
    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-4 flex flex-col">
      <div class="flex justify-between items-center mb-2">
        <label class="text-sm font-semibold text-gray-700" for="html-in">HTML</label>
        <div class="flex gap-3 text-sm">
          <label class="flex items-center gap-1 text-gray-700">
            <input id="html-scripts" type="checkbox" class="w-4 h-4">
            Allow scripts
          </label>
          <button id="html-clear" class="text-gray-500 hover:text-gray-700"><i class="fa-regular fa-trash-can mr-1"></i>Clear</button>
        </div>
      </div>
      <textarea id="html-in" rows="22" class="w-full p-4 border border-gray-200 rounded-xl font-mono text-sm flex-1" spellcheck="false"></textarea>
    </div>
    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-4 flex flex-col">
      <label class="block text-sm font-semibold text-gray-700 mb-2">Live preview</label>
      <iframe id="html-out" sandbox="allow-same-origin" class="w-full flex-1 min-h-[480px] border border-gray-200 rounded-xl bg-white"></iframe>
    </div>
  </div>
</div>

<script>
  (function () {
    const input = document.getElementById("html-in");
    const out = document.getElementById("html-out");
    const scripts = document.getElementById("html-scripts");
    const initial = '<!DOCTYPE html>\n<html>\n<head>\n  <style>\n    body { font-family: system-ui; padding: 2rem; }\n    .card { padding: 1rem; background: #eef2ff; border-radius: 0.75rem; }\n  </style>\n</head>\n<body>\n  <h1>Hello from the HTML viewer</h1>\n  <p>Edit on the left to see live changes.</p>\n  <div class="card">\n    Scripts are off by default for safety - turn them on with the checkbox above.\n  </div>\n</body>\n</html>';

    function render() {
      out.setAttribute("sandbox", scripts.checked ? "allow-scripts" : "allow-same-origin");
      out.srcdoc = input.value;
    }

    [input, scripts].forEach((el) => el.addEventListener("input", render));
    document.getElementById("html-clear").addEventListener("click", () => {
      input.value = "";
      render();
    });

    input.value = initial;
    render();
  })();
</script>
