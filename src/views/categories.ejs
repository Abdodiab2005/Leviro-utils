<nav aria-label="Breadcrumb" class="text-sm text-gray-500 mb-6">
  <a href="/" class="hover:text-indigo-600">Home</a>
  <span class="mx-2">/</span>
  <span class="text-gray-700">Categories</span>
</nav>

<header class="text-center mb-10">
  <h1 class="text-4xl md:text-5xl font-extrabold text-gray-900 mb-3">Browse by category</h1>
  <p class="text-lg text-gray-600 max-w-2xl mx-auto leading-relaxed">
    Five focused collections covering everything from developer utilities to
    everyday calculators. Pick a category to explore its tools.
  </p>
</header>

<section class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
  <% categoriesData.forEach((c) => { %>
    <a href="/categories/<%= c.slug %>" class="group bg-white p-6 rounded-2xl shadow-sm hover:shadow-xl transition-all duration-300 border border-gray-100 hover:border-indigo-200">
      <div class="w-12 h-12 bg-indigo-50 text-indigo-600 rounded-xl flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
        <i class="<%= c.icon %> text-xl"></i>
      </div>
      <h2 class="text-xl font-bold text-gray-900 mb-2 group-hover:text-indigo-600 transition-colors"><%= c.name %></h2>
      <p class="text-sm text-gray-600 leading-relaxed mb-3"><%= c.description %></p>
      <span class="inline-block text-xs font-semibold text-indigo-600 bg-indigo-50 px-2 py-1 rounded">
        <%= c.tools.length %> tool<%= c.tools.length === 1 ? '' : 's' %>
      </span>
    </a>
  <% }); %>
</section>
