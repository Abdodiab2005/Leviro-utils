<nav aria-label="Breadcrumb" class="text-sm text-gray-500 mb-6">
  <a href="<%= localePrefix || '/' %>" class="hover:text-indigo-600"><%= locale === 'ar' ? 'الرئيسية' : 'Home' %></a>
  <span class="mx-2">/</span>
  <a href="<%= localePrefix %>/categories" class="hover:text-indigo-600"><%= t('categories.title') %></a>
  <span class="mx-2">/</span>
  <span class="text-gray-700"><%= t('categories.' + category.slug + '.name') %></span>
</nav>

<header class="text-center mb-10">
  <div class="inline-flex items-center justify-center w-16 h-16 rounded-2xl bg-indigo-50 text-indigo-600 mb-4">
    <i class="<%= category.icon %> text-2xl"></i>
  </div>
  <h1 class="text-4xl md:text-5xl font-extrabold text-gray-900 mb-3"><%= t('categories.' + category.slug + '.name') %></h1>
  <p class="text-lg text-gray-600 max-w-2xl mx-auto leading-relaxed"><%= t('categories.' + category.slug + '.description') %></p>
  <p class="mt-3 text-sm text-gray-500">
    <%= category.tools.length %> <%= locale === 'ar' ? 'أداة في هذه الفئة' : ('tool' + (category.tools.length === 1 ? '' : 's') + ' in this category') %>
  </p>
</header>

<section class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
  <% category.tools.forEach((tool) => { %>
    <a href="<%= localePrefix %><%= tool.href %>" class="group bg-white p-6 rounded-2xl shadow-sm hover:shadow-xl transition-all duration-300 border border-gray-100 hover:border-indigo-200 relative overflow-hidden">
      <div class="w-12 h-12 <%= tool.color %> rounded-xl flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
        <i class="<%= tool.icon %> text-xl"></i>
      </div>
      <h2 class="text-lg font-bold text-gray-900 mb-2 group-hover:text-indigo-600 transition-colors"><%= t('tools.' + tool.key + '.title') %></h2>
      <p class="text-sm text-gray-600 leading-relaxed"><%= t('tools.' + tool.key + '.description') %></p>
    </a>
  <% }); %>
</section>

<aside class="mt-12 text-center">
  <a href="<%= localePrefix %>/categories" class="inline-flex items-center gap-2 text-indigo-600 hover:text-indigo-700 font-medium">
    <i class="fa-solid fa-arrow-<%= locale === 'ar' ? 'right' : 'left' %>"></i>
    <%= locale === 'ar' ? 'تصفح جميع الفئات' : 'Browse all categories' %>
  </a>
</aside>
