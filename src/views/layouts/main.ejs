<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('../partials/head') %>
  </head>
  <body
    class="bg-gray-50 text-gray-900 font-sans antialiased flex flex-col min-h-screen"
  >
    <%- include('../partials/header') %>

    <main class="grow container mx-auto px-4 py-8"><%- body %></main>

    <%- include('../partials/footer') %>

    <script>
      if ("serviceWorker" in navigator) {
        window.addEventListener("load", () => {
          navigator.serviceWorker
            .register("/sw.js", { updateViaCache: "none" })
            .then((registration) => {
              // Check for updates whenever the tab becomes visible again
              document.addEventListener("visibilitychange", () => {
                if (document.visibilityState === "visible") registration.update();
              });

              // If a new SW takes over, refresh once so users see the update
              let refreshed = false;
              navigator.serviceWorker.addEventListener("controllerchange", () => {
                if (refreshed) return;
                refreshed = true;
                window.location.reload();
              });

              // When a new worker finishes installing, ask it to activate now
              registration.addEventListener("updatefound", () => {
                const sw = registration.installing;
                if (!sw) return;
                sw.addEventListener("statechange", () => {
                  if (sw.state === "installed" && navigator.serviceWorker.controller) {
                    sw.postMessage("SKIP_WAITING");
                  }
                });
              });
            })
            .catch((err) => console.warn("SW registration failed:", err));
        });
      }
    </script>
  </body>
</html>
