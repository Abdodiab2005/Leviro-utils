<div class="max-w-3xl mx-auto">
  <%- include('../partials/tool-header', {
    heading: 'Base64 Encoder & Decoder',
    subtitle: 'Encode any text to Base64 or decode Base64 back to plain text. Everything runs in your browser - your data never leaves your device.',
    icon: 'fa-solid fa-file-code',
    color: 'bg-emerald-100 text-emerald-600'
  }) %>

  <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 md:p-8 space-y-6">
    <div class="flex gap-2 bg-gray-100 p-1 rounded-xl w-fit mx-auto">
      <button data-mode="encode" class="mode-btn px-4 py-2 rounded-lg bg-white shadow font-medium">Encode</button>
      <button data-mode="decode" class="mode-btn px-4 py-2 rounded-lg font-medium text-gray-600">Decode</button>
    </div>

    <div>
      <label class="block text-sm font-medium text-gray-700 mb-2">Input</label>
      <textarea id="b64-input" rows="6" placeholder="Type or paste text here..."
        class="w-full p-4 border border-gray-200 rounded-xl focus:ring-2 focus:ring-emerald-500 focus:border-transparent font-mono text-sm"></textarea>
    </div>

    <div>
      <div class="flex justify-between items-center mb-2">
        <label class="block text-sm font-medium text-gray-700">Output</label>
        <button id="b64-copy" class="text-sm text-emerald-600 hover:text-emerald-700 font-medium">
          <i class="fa-regular fa-copy mr-1"></i>Copy
        </button>
      </div>
      <textarea id="b64-output" rows="6" readonly
        class="w-full p-4 border border-gray-200 rounded-xl bg-gray-50 font-mono text-sm"></textarea>
    </div>
  </div>

  <section class="max-w-none mt-12 text-gray-700">
    <h2 class="text-2xl font-bold text-gray-900 mb-3">About Base64 encoding</h2>
    <p>Base64 is a binary-to-text encoding scheme that represents binary data using 64 ASCII characters. It's commonly used in email attachments, data URLs, and embedding small images directly in HTML or CSS. This tool encodes and decodes Base64 entirely client-side - none of your input is sent to a server.</p>
  </section>
</div>

<script>
  const input = document.getElementById("b64-input");
  const output = document.getElementById("b64-output");
  const buttons = document.querySelectorAll(".mode-btn");
  let mode = "encode";

  buttons.forEach((b) => b.addEventListener("click", () => {
    mode = b.dataset.mode;
    buttons.forEach((x) => {
      x.classList.toggle("bg-white", x === b);
      x.classList.toggle("shadow", x === b);
      x.classList.toggle("text-gray-600", x !== b);
    });
    run();
  }));

  function run() {
    const v = input.value;
    if (!v) { output.value = ""; return; }
    try {
      output.value = mode === "encode"
        ? btoa(unescape(encodeURIComponent(v)))
        : decodeURIComponent(escape(atob(v.trim())));
    } catch (e) {
      output.value = "Invalid input for " + mode + " mode";
    }
  }

  input.addEventListener("input", run);
  document.getElementById("b64-copy").addEventListener("click", async () => {
    if (!output.value) return;
    await navigator.clipboard.writeText(output.value);
  });
</script>
