<div class="max-w-3xl mx-auto">
  <%- include('../partials/tool-header', {
    heading: 'Lorem Ipsum Generator',
    subtitle: 'Generate placeholder text by paragraphs, sentences, or words. Perfect for mockups, wireframes, and content drafts.',
    icon: 'fa-solid fa-align-left',
    color: 'bg-amber-100 text-amber-600'
  }) %>

  <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 md:p-8 space-y-6">
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-2">Type</label>
        <select id="li-type" class="w-full p-3 border border-gray-200 rounded-xl">
          <option value="paragraphs">Paragraphs</option>
          <option value="sentences">Sentences</option>
          <option value="words">Words</option>
        </select>
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-2">Count</label>
        <input id="li-count" type="number" min="1" max="100" value="3"
          class="w-full p-3 border border-gray-200 rounded-xl"/>
      </div>
      <div class="flex items-end">
        <label class="flex items-center gap-2 text-sm text-gray-700">
          <input type="checkbox" id="li-classic" checked class="w-4 h-4 text-amber-600 rounded">
          Start with "Lorem ipsum..."
        </label>
      </div>
    </div>

    <button id="li-gen" class="w-full py-3 bg-amber-500 hover:bg-amber-600 text-white font-semibold rounded-xl">
      Generate
    </button>

    <div>
      <div class="flex justify-between items-center mb-2">
        <label class="text-sm font-medium text-gray-700">Output</label>
        <button id="li-copy" class="text-sm text-amber-600 hover:text-amber-700"><i class="fa-regular fa-copy mr-1"></i>Copy</button>
      </div>
      <textarea id="li-out" rows="10" readonly class="w-full p-4 border border-gray-200 rounded-xl bg-gray-50 text-sm leading-relaxed"></textarea>
    </div>
  </div>
</div>

<script>
  const WORDS = "lorem ipsum dolor sit amet consectetur adipiscing elit sed do eiusmod tempor incididunt ut labore et dolore magna aliqua enim ad minim veniam quis nostrud exercitation ullamco laboris nisi aliquip ex ea commodo consequat duis aute irure in reprehenderit voluptate velit esse cillum eu fugiat nulla pariatur excepteur sint occaecat cupidatat non proident sunt culpa qui officia deserunt mollit anim id est laborum".split(" ");
  const cap = (s) => s.charAt(0).toUpperCase() + s.slice(1);
  const rand = (n) => Math.floor(Math.random() * n);
  const word = () => WORDS[rand(WORDS.length)];
  const sentence = () => {
    const len = 8 + rand(10);
    const w = Array.from({length: len}, word);
    return cap(w.join(" ")) + ".";
  };
  const paragraph = () => Array.from({length: 4 + rand(4)}, sentence).join(" ");

  function generate() {
    const type = document.getElementById("li-type").value;
    const count = Math.max(1, Math.min(100, +document.getElementById("li-count").value || 1));
    const classic = document.getElementById("li-classic").checked;
    let out = "";
    if (type === "words") {
      out = Array.from({length: count}, word).join(" ");
      if (classic) out = "Lorem ipsum dolor sit amet " + out.split(" ").slice(5).join(" ");
    } else if (type === "sentences") {
      out = Array.from({length: count}, sentence).join(" ");
      if (classic) out = "Lorem ipsum dolor sit amet, consectetur adipiscing elit. " + Array.from({length: count - 1}, sentence).join(" ");
    } else {
      const paras = Array.from({length: count}, paragraph);
      if (classic) paras[0] = "Lorem ipsum dolor sit amet, consectetur adipiscing elit. " + paras[0];
      out = paras.join("\n\n");
    }
    document.getElementById("li-out").value = out;
  }

  document.getElementById("li-gen").addEventListener("click", generate);
  document.getElementById("li-copy").addEventListener("click", async () => {
    const v = document.getElementById("li-out").value;
    if (v) await navigator.clipboard.writeText(v);
  });
  generate();
</script>
