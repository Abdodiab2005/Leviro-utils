<div class="max-w-7xl mx-auto">
  <%- include('../partials/tool-header', {
    heading: 'HTML to Markdown Converter',
    subtitle: 'Paste HTML and get clean Markdown output. Handles headings, lists, links, images, tables, code blocks, and inline formatting.',
    icon: 'fa-solid fa-arrow-right-arrow-left',
    color: 'bg-emerald-100 text-emerald-600'
  }) %>

  <div class="grid lg:grid-cols-2 gap-4">
    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-4 flex flex-col">
      <div class="flex justify-between items-center mb-2">
        <label class="text-sm font-semibold text-gray-700">HTML input</label>
        <button id="h2m-clear" class="text-sm text-gray-500"><i class="fa-regular fa-trash-can mr-1"></i>Clear</button>
      </div>
      <textarea id="h2m-in" rows="20" class="w-full p-4 border border-gray-200 rounded-xl font-mono text-sm flex-1" spellcheck="false"></textarea>
    </div>
    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-4 flex flex-col">
      <div class="flex justify-between items-center mb-2">
        <label class="text-sm font-semibold text-gray-700">Markdown output</label>
        <button id="h2m-copy" class="text-sm text-emerald-600"><i class="fa-regular fa-copy mr-1"></i>Copy</button>
      </div>
      <textarea id="h2m-out" rows="20" readonly class="w-full p-4 border border-gray-200 rounded-xl bg-gray-50 font-mono text-sm flex-1"></textarea>
    </div>
  </div>

  <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-4 mt-4 grid sm:grid-cols-3 gap-3 text-sm">
    <label class="flex items-center gap-2">Heading style:
      <select id="h2m-heading" class="p-2 border rounded-lg flex-1">
        <option value="atx" selected># H1</option>
        <option value="setext">Underlined</option>
      </select>
    </label>
    <label class="flex items-center gap-2">Bullet:
      <select id="h2m-bullet" class="p-2 border rounded-lg flex-1">
        <option value="-" selected>-</option>
        <option value="*">*</option>
        <option value="+">+</option>
      </select>
    </label>
    <label class="flex items-center gap-2">Code style:
      <select id="h2m-code" class="p-2 border rounded-lg flex-1">
        <option value="fenced" selected>``` fenced</option>
        <option value="indented">Indented</option>
      </select>
    </label>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/turndown@7.2.0/dist/turndown.min.js" crossorigin="anonymous" defer></script>
<script src="https://cdn.jsdelivr.net/npm/turndown-plugin-gfm@1.0.2/dist/turndown-plugin-gfm.js" crossorigin="anonymous" defer></script>
<script>
  (function () {
    const input = document.getElementById("h2m-in");
    const out = document.getElementById("h2m-out");
    const heading = document.getElementById("h2m-heading");
    const bullet = document.getElementById("h2m-bullet");
    const code = document.getElementById("h2m-code");
    const initial = '<h1>Sample document</h1>\n<p>This is a <strong>bold</strong> paragraph with a <a href="https://leviro.net">link</a>.</p>\n<ul>\n  <li>First item</li>\n  <li>Second item</li>\n</ul>\n<table>\n  <thead><tr><th>Name</th><th>Role</th></tr></thead>\n  <tbody>\n    <tr><td>Ada</td><td>Engineer</td></tr>\n    <tr><td>Linus</td><td>Architect</td></tr>\n  </tbody>\n</table>\n<pre><code>const x = 42;</code></pre>';

    function ready() { return typeof TurndownService !== "undefined"; }

    function convert() {
      if (!ready()) { setTimeout(convert, 100); return; }
      const td = new TurndownService({
        headingStyle: heading.value,
        bulletListMarker: bullet.value,
        codeBlockStyle: code.value,
        emDelimiter: "_",
        strongDelimiter: "**",
      });
      if (typeof turndownPluginGfm !== "undefined") {
        td.use(turndownPluginGfm.gfm);
      }
      out.value = td.turndown(input.value || "");
    }

    [input, heading, bullet, code].forEach((el) => el.addEventListener("input", convert));
    document.getElementById("h2m-copy").addEventListener("click", async () => {
      if (out.value) await navigator.clipboard.writeText(out.value);
    });
    document.getElementById("h2m-clear").addEventListener("click", () => {
      input.value = "";
      convert();
    });

    input.value = initial;
    window.addEventListener("load", convert);
    convert();
  })();
</script>
