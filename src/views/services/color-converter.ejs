<div class="max-w-3xl mx-auto">
  <%- include('../partials/tool-header', {
    heading: 'Color Converter & Picker',
    subtitle: 'Pick any color and instantly convert between HEX, RGB, RGBA, and HSL formats. Live preview with one-click copy.',
    icon: 'fa-solid fa-palette',
    color: 'bg-fuchsia-100 text-fuchsia-600'
  }) %>

  <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 md:p-8 space-y-6">
    <div class="flex flex-col md:flex-row gap-6 items-center">
      <input type="color" id="picker" value="#4f46e5"
        class="w-32 h-32 rounded-2xl border-2 border-gray-200 cursor-pointer"/>
      <div class="flex-1 w-full grid grid-cols-1 sm:grid-cols-2 gap-3">
        <div>
          <label class="text-xs font-semibold text-gray-500">HEX</label>
          <div class="flex gap-2">
            <input id="hex" class="flex-1 p-2 border rounded-lg font-mono text-sm" />
            <button data-copy="hex" class="px-3 text-fuchsia-600"><i class="fa-regular fa-copy"></i></button>
          </div>
        </div>
        <div>
          <label class="text-xs font-semibold text-gray-500">RGB</label>
          <div class="flex gap-2">
            <input id="rgb" readonly class="flex-1 p-2 bg-gray-50 border rounded-lg font-mono text-sm" />
            <button data-copy="rgb" class="px-3 text-fuchsia-600"><i class="fa-regular fa-copy"></i></button>
          </div>
        </div>
        <div>
          <label class="text-xs font-semibold text-gray-500">RGBA</label>
          <div class="flex gap-2">
            <input id="rgba" readonly class="flex-1 p-2 bg-gray-50 border rounded-lg font-mono text-sm" />
            <button data-copy="rgba" class="px-3 text-fuchsia-600"><i class="fa-regular fa-copy"></i></button>
          </div>
        </div>
        <div>
          <label class="text-xs font-semibold text-gray-500">HSL</label>
          <div class="flex gap-2">
            <input id="hsl" readonly class="flex-1 p-2 bg-gray-50 border rounded-lg font-mono text-sm" />
            <button data-copy="hsl" class="px-3 text-fuchsia-600"><i class="fa-regular fa-copy"></i></button>
          </div>
        </div>
      </div>
    </div>
    <div>
      <label class="text-sm font-medium text-gray-700">Alpha: <span id="alpha-val">1.00</span></label>
      <input type="range" id="alpha" min="0" max="1" step="0.01" value="1" class="w-full"/>
    </div>
    <div id="preview" class="h-24 rounded-xl border border-gray-200" style="background:#4f46e5"></div>
  </div>
</div>

<script>
  const picker = document.getElementById("picker");
  const hex = document.getElementById("hex");
  const rgb = document.getElementById("rgb");
  const rgba = document.getElementById("rgba");
  const hsl = document.getElementById("hsl");
  const alpha = document.getElementById("alpha");
  const alphaVal = document.getElementById("alpha-val");
  const preview = document.getElementById("preview");

  const hexToRgb = (h) => {
    const m = h.replace("#", "").match(/.{1,2}/g);
    if (!m || m.length < 3) return null;
    return m.slice(0, 3).map((x) => parseInt(x, 16));
  };

  const rgbToHsl = (r, g, b) => {
    r/=255; g/=255; b/=255;
    const max = Math.max(r,g,b), min = Math.min(r,g,b);
    let h, s, l = (max+min)/2;
    if (max === min) { h = s = 0; }
    else {
      const d = max-min;
      s = l > 0.5 ? d/(2-max-min) : d/(max+min);
      switch(max){
        case r: h = (g-b)/d + (g<b?6:0); break;
        case g: h = (b-r)/d + 2; break;
        case b: h = (r-g)/d + 4; break;
      }
      h /= 6;
    }
    return [Math.round(h*360), Math.round(s*100), Math.round(l*100)];
  };

  function update(source) {
    let h = hex.value.trim();
    if (source === "picker") h = picker.value;
    if (!/^#?[0-9a-fA-F]{6}$/.test(h)) return;
    if (!h.startsWith("#")) h = "#" + h;
    const [r,g,b] = hexToRgb(h);
    const a = parseFloat(alpha.value);
    const [hh,ss,ll] = rgbToHsl(r,g,b);
    picker.value = h;
    hex.value = h;
    rgb.value = `rgb(${r}, ${g}, ${b})`;
    rgba.value = `rgba(${r}, ${g}, ${b}, ${a})`;
    hsl.value = `hsl(${hh}, ${ss}%, ${ll}%)`;
    alphaVal.textContent = a.toFixed(2);
    preview.style.background = `rgba(${r}, ${g}, ${b}, ${a})`;
  }

  picker.addEventListener("input", () => update("picker"));
  hex.addEventListener("input", () => update("hex"));
  alpha.addEventListener("input", () => update("alpha"));

  document.querySelectorAll("[data-copy]").forEach((b) => b.addEventListener("click", async () => {
    const el = document.getElementById(b.dataset.copy);
    if (el.value) await navigator.clipboard.writeText(el.value);
  }));

  update("picker");
</script>
