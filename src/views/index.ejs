<div class="space-y-16">
  <section class="text-center space-y-6 py-12 md:py-20">
    <h1 class="text-5xl md:text-7xl font-extrabold text-transparent bg-clip-text bg-linear-to-r from-indigo-600 to-purple-600 tracking-tight">
      <%= t('home.hero.title') %>
    </h1>
    <p class="text-xl md:text-2xl text-gray-600 max-w-3xl mx-auto leading-relaxed">
      <%= t('home.hero.subtitle') %>
    </p>
    <div class="flex flex-col sm:flex-row justify-center gap-4 pt-4">
      <a href="#tools" class="px-8 py-3 bg-indigo-600 text-white font-semibold rounded-full hover:bg-indigo-700 transition-all shadow-lg hover:shadow-xl transform hover:-translate-y-1">
        <%= t('home.hero.exploreBtn').replace('%d', totalToolCount) %>
      </a>
      <a href="<%= localePrefix %>/categories" class="px-8 py-3 bg-white text-indigo-600 font-semibold rounded-full border border-indigo-100 hover:border-indigo-200 hover:bg-indigo-50 transition-all shadow-sm hover:shadow-md">
        <i class="fa-solid fa-layer-group me-1"></i> <%= t('home.hero.browseCategories') %>
      </a>
    </div>

    <div class="flex flex-wrap justify-center gap-3 pt-6 text-sm">
      <span class="px-3 py-1 bg-emerald-50 text-emerald-700 rounded-full"><i class="fa-solid fa-bolt me-1"></i> <%= t('home.hero.lightningFast') %></span>
      <span class="px-3 py-1 bg-blue-50 text-blue-700 rounded-full"><i class="fa-solid fa-lock me-1"></i> <%= t('home.hero.privacyFirst') %></span>
      <span class="px-3 py-1 bg-purple-50 text-purple-700 rounded-full"><i class="fa-solid fa-mobile-screen me-1"></i> <%= t('home.hero.worksOffline') %></span>
      <span class="px-3 py-1 bg-amber-50 text-amber-700 rounded-full"><i class="fa-solid fa-circle-dollar-to-slot me-1"></i> <%= t('home.hero.free') %></span>
    </div>
  </section>

  <section id="tools" class="space-y-12">
    <% categoriesData.forEach((cat) => { %>
      <div class="space-y-6">
        <div class="flex items-center justify-between border-b border-gray-200 pb-3">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center">
              <i class="<%= cat.icon %>"></i>
            </div>
            <div>
              <h2 class="text-2xl font-bold text-gray-900"><%= t('categories.' + cat.slug + '.name') %></h2>
              <p class="text-sm text-gray-500"><%= t('categories.' + cat.slug + '.description') %></p>
            </div>
          </div>
          <a href="<%= localePrefix %>/categories/<%= cat.slug %>" class="hidden sm:inline-flex items-center gap-1 text-sm font-medium text-indigo-600 hover:text-indigo-700">
            <%= t('home.viewAll') %> <i class="fa-solid fa-arrow-right text-xs"></i>
          </a>
        </div>

        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
          <% cat.tools.forEach((tool) => { %>
            <a href="<%= localePrefix %><%= tool.href %>" class="group bg-white p-6 rounded-2xl shadow-sm hover:shadow-xl transition-all duration-300 border border-gray-100 hover:border-indigo-200 relative overflow-hidden">
              <div class="w-12 h-12 <%= tool.color %> rounded-xl flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
                <i class="<%= tool.icon %> text-xl"></i>
              </div>
              <h3 class="text-lg font-bold text-gray-900 mb-2 group-hover:text-indigo-600 transition-colors">
                <%= t('tools.' + tool.key + '.title') %>
              </h3>
              <p class="text-sm text-gray-600 leading-relaxed"><%= t('tools.' + tool.key + '.description') %></p>
            </a>
          <% }); %>
        </div>
      </div>
    <% }); %>
  </section>

  <section class="bg-white rounded-2xl shadow-sm border border-gray-100 p-8 md:p-12">
    <div class="grid md:grid-cols-2 gap-8 items-center">
      <div>
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4"><%= t('home.why.title') %></h2>
        <p class="text-gray-600 leading-relaxed mb-4">
          <%= t('home.why.description') %>
        </p>
        <ul class="space-y-2 text-gray-700">
          <li class="flex gap-2"><i class="fa-solid fa-check text-emerald-600 mt-1"></i> <%= t('home.why.featureFree') %></li>
          <li class="flex gap-2"><i class="fa-solid fa-check text-emerald-600 mt-1"></i> <%= t('home.why.featureMobile') %></li>
          <li class="flex gap-2"><i class="fa-solid fa-check text-emerald-600 mt-1"></i> <%= t('home.why.featureOffline') %></li>
          <li class="flex gap-2"><i class="fa-solid fa-check text-emerald-600 mt-1"></i> <%= t('home.why.featureOpenSource') %></li>
        </ul>
      </div>
      <div class="grid grid-cols-2 gap-4">
        <div class="bg-indigo-50 p-6 rounded-2xl text-center">
          <div class="text-4xl font-bold text-indigo-600"><%= totalToolCount %>+</div>
          <div class="text-sm text-gray-600 mt-1"><%= t('home.stats.toolsAvailable') %></div>
        </div>
        <div class="bg-emerald-50 p-6 rounded-2xl text-center">
          <div class="text-4xl font-bold text-emerald-600">100%</div>
          <div class="text-sm text-gray-600 mt-1"><%= t('home.stats.freeToUse') %></div>
        </div>
        <div class="bg-purple-50 p-6 rounded-2xl text-center">
          <div class="text-4xl font-bold text-purple-600">0</div>
          <div class="text-sm text-gray-600 mt-1"><%= t('home.stats.adsOrTrackers') %></div>
        </div>
        <div class="bg-amber-50 p-6 rounded-2xl text-center">
          <div class="text-4xl font-bold text-amber-600">PWA</div>
          <div class="text-sm text-gray-600 mt-1"><%= t('home.stats.installable') %></div>
        </div>
      </div>
    </div>
  </section>
</div>
